{
  "name": "@trafficvaulthub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply trafficvaulthub --local",
    "db:migrate:remote": "wrangler d1 migrations apply trafficvaulthub --remote",
    "db:create": "wrangler d1 create trafficvaulthub"
  },
  "dependencies": {
    "@trafficvaulthub/shared": "*",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@cloudflare/vitest-pool-workers": "^0.7.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.2"
  }
}
